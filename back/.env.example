# Copie para .env e preencha. NUNCA commite o .env (o repositório é público).

PORT=5000
FRONTEND_URL=http://localhost:3000
# Base dos links enviados por e-mail (redefinição de senha)
APP_URL=https://olympus-33lb.onrender.com

# Banco
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Auth — string aleatória longa (ex: openssl rand -hex 48)
JWT_SECRET=
# Ids de usuário com acesso de administrador (catálogo de exercícios, lista de usuários)
ADMIN_USER_IDS=

# Cloudinary (avatares e mídia dos exercícios)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mail (Gmail com senha de app)
EMAIL_USER=
EMAIL_PASS=

# Hércules
OPENAI_API_KEY=
OPENAI_MODEL=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@exemplo.com

# Google Play Billing (ver ASSINATURAS_ANDROID.md)
ANDROID_PACKAGE_NAME=br.com.fenrystech.atlanteon
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=
RTDN_SECRET=
